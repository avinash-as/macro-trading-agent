   "source": [
    "# Macro Trading ML Pipeline - Demo Notebook\n",
    "\n",
    "This notebook demonstrates the complete macro trading pipeline from data ingestion to model predictions and visualization."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Setup\n",
    "import sys\n",
    "sys.path.append('src')\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from datetime import datetime, timedelta\n",
    "\n",
    "# Import pipeline components\n",
    "from utils.config import config\n",
    "from utils.logger import setup_logging\n",
    "from utils.database import db\n",
    "from data_ingestion.apify_scraper import ApifyMacroScraper\n",
    "from data_ingestion.tavily_scraper import TavilyNewsScraper\n",
    "from feature_engineering.features import MacroFeatureEngineer\n",
    "from feature_engineering.macro_summary import MacroSummaryGenerator\n",
    "from modeling.trainer import MacroModelTrainer\n",
    "from visualization.charts import MacroVisualizer, MatplotlibVisualizer\n",
    "\n",
    "# Setup logging\n",
    "logger = setup_logging('notebook')\n",
    "\n",
    "print(\"Pipeline components loaded successfully!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Data Ingestion\n",
    "\n",
    "Scrape macroeconomic calendar and economic news. Uses mock data if API tokens not configured."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Initialize scrapers\n",
    "apify_scraper = ApifyMacroScraper()\n",
    "tavily_scraper = TavilyNewsScraper()\n",
    "\n",
    "# Scrape macro calendar (180 days)\n",
    "print(\"Scraping macro calendar...\")\n",
    "macro_events = apify_scraper.scrape_calendar(lookback_days=180)\n",
    "print(f\"Found {len(macro_events)} macro events\")\n",
    "\n",
    "# Scrape economic news (30 days)\n",
    "print(\"Scraping economic news...\")\n",
    "news_articles = tavily_scraper.scrape_economic_news(days_back=30)\n",
    "print(f\"Found {len(news_articles)} news articles\")\n",
    "\n",
    "# Save to database\n",
    "apify_scraper.save_to_database(macro_events)\n",
    "tavily_scraper.save_to_database(news_articles)\n",
    "\n",
    "# Show sample data\n",
    "macro_df = pd.DataFrame(macro_events)\n",
    "news_df = pd.DataFrame(news_articles)\n",
    "\n",
    "print(\"\\nMacro Events Sample:\")\n",
    "print(macro_df[['event_name', 'event_date', 'actual_value', 'forecast_value', 'surprise']].head(10) if 'surprise' in macro_df.columns else macro_df[['event_name', 'event_date', 'actual_value', 'forecast_value']].head(10))\n",
    "\n",
    "print(\"\\nNews Articles Sample:\")\n",
    "print(news_df[['title', 'source', 'sentiment_score', 'relevance_score']].head())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Feature Engineering\n",
    "\n",
    "Create quantitative features from macro events and news sentiment."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Initialize feature engineer\n",
    "engineer = MacroFeatureEngineer()\n",
    "\n",
    "# Date range\n",
    "end_date = datetime.now().strftime(\"%Y-%m-%d\")\n",
    "start_date = (datetime.now() - timedelta(days=180)).strftime(\"%Y-%m-%d\")\n",
    "\n",
    "# Build feature matrix\n",
    "print(\"Building feature matrix...\")\n",
    "features = engineer.build_feature_matrix(start_date, end_date)\n",
    "\n",
    print(f\"Feature matrix shape: {features.shape}\")\n",
    print(f\"Date range: {features['feature_date'].min()} to {features['feature_date'].max()}\")\n",
    print(f\"Number of features: {len(features.columns) - 1}\")  # Exclude date column\n",
    "\n",
    "# Show feature categories\n",
    "feature_categories = {}\n",
    "for col in features.columns:\n",
    "    if col != 'feature_date':\n",
    "        prefix = col.split('_')[0]\n",
    "        feature_categories[prefix] = feature_categories.get(prefix, 0) + 1\n",
    "\n",
    "print(\"\\nFeature categories:\")\n",
    "for cat, count in sorted(feature_categories.items()):\n",
    "    print(f\"  {cat}: {count}\")\n",
    "\n",
    "# Save features\n",
    "engineer.save_features(features)\n",
    "print(\"\\nFeatures saved to database and data/processed/features.csv\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Macro Economic Outlook\n",
    "\n",
    "Generate 1-page macro summary with key themes, risks, and trading implications."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generate outlook\n",
    "generator = MacroSummaryGenerator()\n",
    "outlook = generator.generate_outlook(lookback_days=60)\n",
    "\n",
    "# Save reports\n",
    "md_path = generator.save_report(outlook, \"markdown\")\n",
    "json_path = generator.save_report(outlook, \"json\")\n",
    "\n",
    print(f\"Outlook saved to {md_path} and {json_path}\")\n",
    "\n",
    "# Display key sections\n",
    "print(\"=\" * 60)\n",
    "print(\"KEY THEMES\")\n",
    "print(\"=\" * 60)\n",
    "for i, theme in enumerate(outlook['key_themes'], 1):\n",
    "    print(f\"{i}. {theme}\")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 60)\n",
    "print(\"RISK FACTORS\")\n",
    "print(\"=\" * 60)\n",
    "for i, risk in enumerate(outlook['risk_factors'], 1):\n",
    "    print(f\"{i}. {risk}\")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 60)\n",
    "print(\"TRADING IMPLICATIONS\")\n",
    "print(\"=\" * 60)\n",
    "for asset, details in outlook['trading_implications'].items():\n",
    "    print(f\"\\n{asset.upper()}: {details['bias']}\")\n",
    "    print(f\"  Strategy: {details['strategy']}\")\n",
    "    print(f\"  Risk: {details['risk']}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Model Training & Walk-Forward Validation\n",
    "\n",
    "Train multiple models with rigorous out-of-sample validation."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Initialize trainer\n",
    "trainer = MacroModelTrainer()\n",
    "\n",
    "# Load macro events for target creation\n",
    "macro_df = engineer.load_macro_data(start_date, end_date)\n",
    "macro_events = engineer.create_event_features(macro_df)\n",
    "\n",
    "# Prepare targets\n",
    "features_with_targets = trainer.prepare_targets(features, macro_events)\n",
    "\n",
    "# Run walk-forward validation\n",
    "target_col = f'target_surprise_{trainer.target_horizon}d'\n",
    "print(f\"Running walk-forward validation for target: {target_col}\")\n",
    "results = trainer.walk_forward_validation(features_with_targets, target_col)\n",
    "\n",
    "# Display results\n",
    "print(\"\\n\" + \"=\" * 60)\n",
    "print(\"WALK-FORWARD VALIDATION RESULTS\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "results_df = pd.DataFrame({\n",
    "    model: {\n",
    "        'RMSE': metrics['mean_rmse'],\n",
    "        'MAE': metrics['mean_mae'],\n",
    "        'R²': metrics['mean_r2'],\n",
    "        'Dir. Acc': f\"{metrics['mean_directional_accuracy']:.1%}\",\n",
    "        'RMSE Std': metrics['std_rmse']\n",
    "    }\n",
    "    for model, metrics in results.items()\n",
    "}).T\n",
    "\n",
    "print(results_df.to_string())\n",
    "\n",
    "# Best model\n",
    "best_model = trainer._get_best_model()\n",
    "print(f\"\\nBest model: {best_model}\")\n",
    "\n",
    "# Save models\n",
    "trainer.save_models()\n",
    "print(\"Models saved to outputs/models/\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Latest Prediction\n",
    "\n",
    "Generate prediction for the most recent data point."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Predict on latest data\n",
    "prediction = trainer.predict_latest(features_with_targets)\n",
    "\n",
    "print(\"=\" * 60)\n",
    "print(\"LATEST PREDICTION\")\n",
    "print(\"=\" * 60)\n",
    "print(f\"Model: {prediction['model']}\")\n",
    "print(f\"Prediction Date: {prediction['prediction_date']}\")\n",
    "print(f\"Target Horizon: {prediction['target_horizon_days']} days\")\n",
    "print(f\"Predicted Surprise: {prediction['predicted_surprise']:.4f}\")\n",
    "print(f\"Direction: {prediction['predicted_direction']}\")\n",
    "print(f\"Confidence: {prediction['confidence']}\")\n",
    "\n",
    "print(\"\\nTop 10 Features:\")\n",
    "for feat in prediction['top_features']:\n",
    "    print(f\"  {feat['feature']}: {feat['importance']:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Visualizations\n",
    "\n",
    "Create interactive charts for analysis and reporting."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Initialize visualizers\n",
    "visualizer = MacroVisualizer()\n",
    "mp_visualizer = MatplotlibVisualizer()\n",
    "\n",
    "# Load data for charts\n",
    "macro_df = engineer.load_macro_data(start_date, end_date)\n",
    "news_df = engineer.load_news_data(start_date, end_date)\n",
    "\n",
    if not macro_df.empty:\n",
    "    macro_events = engineer.create_event_features(macro_df)\n",
    "    visualizer.plot_surprise_timeline(macro_events)\n",
    "    print(\"✓ Surprise timeline created\")\n",
    "\n",
    if not news_df.empty:\n",
    "    visualizer.plot_sentiment_heatmap(news_df)\n",
    "    print(\"✓ Sentiment heatmap created\")\n",
    "\n",
    "# Macro dashboard\n",
    "visualizer.plot_macro_sentiment_dashboard(60)\n",
    "print(\"✓ Macro dashboard created\")\n",
    "\n",
    "# Model charts\n",
    "try:\n",
    "    trainer.load_models()\n",
    "    visualizer.plot_feature_importance(trainer)\n",
    "    print(\"✓ Feature importance chart created\")\n",
    "    \n",
    "    visualizer.plot_walk_forward_results(trainer)\n",
    "    print(\"✓ Walk-forward results chart created\")\n",
    "    \n",
    "    visualizer.plot_prediction_vs_actual(trainer, features_with_targets, target_col)\n",
    "    print(\"✓ Prediction vs actual chart created\")\n",
    "    \n",
    "    visualizer.plot_model_predictions_timeline(trainer, features_with_targets)\n",
    "    print(\"✓ Predictions timeline created\")\n",
    "except Exception as e:\n",
    "    print(f\"Model charts skipped: {e}\")\n",
    "\n",
    "# Summary report charts\n",
    "mp_visualizer.create_summary_report_charts(outlook)\n",
    "print(\"✓ Summary report charts created\")\n",
    "\n",
    "print(\"\\nAll charts saved to outputs/charts/\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Full Pipeline Run\n",
    "\n",
    "Run the complete pipeline in one command."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
